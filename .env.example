# Banking Chat API Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PROD

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://user:gI7_36rpP_aQEj5FyJp9@127.0.0.1:5432/banking_agent_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache & Idempotency Store
REDIS_URL=redis://127.0.0.1:6379/0

# LLM Gateway Configuration (Groq / Fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_ROUTING_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# Rate Limiting
RATE_LIMIT_IP_PER_MINUTE=100
RATE_LIMIT_CUSTOMER_PER_MINUTE=30

# Human-In-The-Loop (HITL) Thresholds
FRAUD_RISK_HITL_THRESHOLD=0.80
TRANSFER_STEP_UP_LIMIT=50000.00

